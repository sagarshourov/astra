# Copy this file to .env.docker, replace placeholders, and keep it private.
MYSQL_APP_PASSWORD=replace_with_strong_password
MYSQL_ROOT_PASSWORD=replace_with_different_strong_password
AUTH_SECRET=replace_with_random_32_byte_secret
OPENAI_API_KEY=replace_with_real_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=700
