# MySQL 8+ (hosted independently of Vercel)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=astra
DATABASE_PASSWORD=replace_me
DATABASE_NAME=astra_ai
DATABASE_SSL=false
# Required random secret: npx auth secret
AUTH_SECRET=replace_with_random_secret
AUTH_TRUST_HOST=true
# OpenAI API secret (server-side only)
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4.1-mini
# Optional: model output token maximum
OPENAI_MAX_OUTPUT_TOKENS=700
